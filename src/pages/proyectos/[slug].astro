---
import ArrowIcon from '../../components/ArrowIcon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
export async function getStaticPaths() { const projects = await getCollection('projects'); return projects.map((project,i) => ({params:{slug:project.id}, props:{project,nextProject:projects[(i+1)%projects.length]}})); }
const { project, nextProject } = Astro.props;
const d = project.data;
---
<BaseLayout title={d.title} description={d.subtitle} immersive><article><header class="detail-hero"><img src={d.heroImage} alt={`Vista principal de ${d.title}`} width="1800" height="1200" fetchpriority="high" /><div class="hero-shade"></div><div class="detail-hero-text"><a class="back-link" href="/proyectos"><ArrowIcon direction="left" /> Todos los proyectos</a><h1>{d.title}</h1><div><p>{d.location}</p><span>{d.category} · {d.year}</span></div></div></header><section class="project-story page-pad"><div class="project-facts"><h2>El proyecto</h2><dl><dt>Ubicación</dt><dd>{d.location}</dd><dt>Superficie</dt><dd>{d.area}</dd><dt>Año</dt><dd>{d.year}</dd><dt>Arquitectura</dt><dd>{d.credits.leadArchitect}</dd><dt>Ingeniería</dt><dd>{d.credits.structuralEngineering}</dd><dt>Fotografía</dt><dd>{d.credits.photography}</dd></dl><a class="text-link" href={`/servicios/${d.serviceSlug}`}>Explorar disciplina <ArrowIcon /></a></div><div class="project-story-copy"><p class="large-copy">{d.subtitle}</p><p>{d.lead}</p><h2>Las decisiones<br />que dan forma.</h2><p>{d.designDecisions}</p><h3>Materia y detalle</h3><ul>{d.materials.map((m:string) => <li>{m}</li>)}</ul></div></section><section class="project-gallery-new page-pad" aria-label="Galería del proyecto">{d.gallery.map((image:{src:string;alt:string;caption?:string}) => <figure data-parallax><div class="gallery-image"><img src={image.src} alt={image.alt} width="1400" height="1000" loading="lazy" /></div>{image.caption && <figcaption>{image.caption}</figcaption>}</figure>)}</section><a class="next-project-new page-pad" href={`/proyectos/${nextProject.id}`}><span>Siguiente proyecto</span><h2>{nextProject.data.title} <ArrowIcon /></h2></a></article></BaseLayout>
