---
import ArchitectureStudies from '../components/ArchitectureStudies.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import EditorialProject from '../components/EditorialProject.astro';
import StudioProcess from '../components/StudioProcess.astro';
import { getCollection } from 'astro:content';
const projects = await getCollection('projects');
const selected = ['casa-pedregal','estudio-tamarindos','refugio-valle-bravo'].map(id => projects.find(p => p.id === id)!);
const services = await getCollection('services');
const serviceOrder = ['arquitectura-residencial','interiorismo-y-materia','consultoria-patrimonial'].map(id => services.find(s => s.id === id)!);
const labels = ['Arquitectura','Interiorismo','Patrimonio'];
---
<BaseLayout immersive>
 <section class="home-hero" aria-label="Arquitectura de Estrato">
  <div class="hero-slides">{selected.map((project,i) => <div class:list={['hero-slide', { 'is-current': i === 0 }]} data-slide={i} aria-hidden={i !== 0}><img src={project.data.heroImage} alt={i === 0 ? 'Casa contemporánea abierta al jardín, con materiales naturales y luz de tarde' : ''} width="1800" height="1200" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} /></div>)}</div>
  <div class="hero-shade"></div>
  <div class="hero-topline"><span>Arquitectura & interiorismo</span><span>CDMX · Madrid · Oaxaca</span></div>
  <h1 class="hero-title"><span>La forma</span><span>de habitar<span class="accent-dot">.</span></span></h1>
  <div class="hero-bottom"><p>Espacios que nacen del lugar.<br />Y se convierten en parte de ti.</p><a class="hero-feature" href={`/proyectos/${selected[0].id}`}><span>Proyecto seleccionado</span><strong><span data-slide-title>{selected[0].data.title}</span> <ArrowIcon /></strong></a><div class="hero-controls">{selected.map((project,i) => <button data-slide-to={i} aria-label={`Mostrar ${project.data.title}`} aria-pressed={i === 0}>0{i+1}</button>)}<button class="next-slide" aria-label="Siguiente proyecto"><ArrowIcon direction="right" /></button></div></div>
  <a class="hero-scroll" href="#introduccion" aria-label="Explorar el taller">Explorar <span aria-hidden="true"><ArrowIcon direction="down" /></span></a>
  <script type="application/json" id="hero-project-data" set:html={JSON.stringify(selected.map(p => ({title:p.data.title,href:`/proyectos/${p.id}`})))} />
 </section>
 <section class="intro-section page-pad" id="introduccion">
  <div class="intro-copy"><h2 data-reveal>La luz dibuja.<br />La materia permanece.</h2><div class="intro-description"><p>Somos Estrato. Un taller de arquitectura e interiorismo que encuentra en cada lugar una manera distinta de vivir.</p><p>Diseñamos desde la escucha, la honestidad de los materiales y el cuidado del detalle. Para que un espacio se sienta tan bien como se ve.</p><a class="text-link" href="/estudio">Dentro del taller <span aria-hidden="true"><ArrowIcon /></span></a></div></div>
  <div class="intro-image" data-parallax><img src="https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=1500&q=85" alt="Interior sereno con madera, tonos naturales y luz de jardín" width="1500" height="1000" loading="lazy" /><span>Materia, luz y vida cotidiana.</span></div>
 </section>
 <section class="selected-section page-pad">
  <div class="section-top"><h2 data-reveal>Espacios con<br />una historia propia.</h2><a class="text-link" href="/proyectos">Todos los proyectos <span aria-hidden="true"><ArrowIcon /></span></a></div>
  <div class="selected-grid">{selected.map((project,i) => <EditorialProject project={project} featured={i === 0} />)}</div>
 </section>
 <section class="discipline-section page-pad">
  <div class="discipline-heading"><h2 data-reveal>Tres maneras de<br />pensar un espacio.</h2><p>Del territorio al último encuentro.<br />Una mirada integral en cada escala.</p></div>
  <div class="discipline-list">{serviceOrder.map((service,i) => <a class="discipline-row" href={`/servicios/${service.id}`}><h3>{labels[i]}</h3><p>{service.data.shortDescription}</p><span aria-hidden="true"><ArrowIcon /></span></a>)}</div>
 </section>
 <ArchitectureStudies />
 <section class="statement-photo" data-parallax><img src="https://images.unsplash.com/photo-1600566753086-00f18fb6b3ea?auto=format&fit=crop&w=1800&q=85" alt="Materiales naturales y luz suave en un interior doméstico" width="1800" height="1200" loading="lazy" /><div class="statement-shade"></div><p>Diseñar es encontrar<br />lo esencial.</p><a href="/servicios">Nuestra manera de hacer <ArrowIcon /></a></section>
 <StudioProcess />
</BaseLayout>
