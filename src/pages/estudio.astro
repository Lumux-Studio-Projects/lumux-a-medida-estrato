---
import BaseLayout from '../layouts/BaseLayout.astro';
import StudioProcess from '../components/StudioProcess.astro';
import site from '../data/site.json';
const principles = [['Materia honesta','La madera muestra su veta. La piedra revela su origen. Elegimos materiales por lo que son y por cómo envejecen.'],['Luz y clima','Observamos la orientación, los vientos y la sombra. La arquitectura responde al lugar antes de imponerle una forma.'],['Permanencia','Diseñamos con la vida cotidiana en mente. Espacios que admiten el paso del tiempo y evolucionan con sus habitantes.']];
---
<BaseLayout title="El taller"><header class="page-opening page-pad"><h1 data-reveal>El lugar primero.<br />La forma después.</h1><div class="opening-bottom"><p>Estrato Taller de Arquitectura.<br />Ciudad de México · Madrid · Oaxaca</p><span>Desde {site.brand.founded}</span></div></header><figure class="studio-bleed" data-parallax><img src="https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=1800&q=85" alt="Espacio abierto de trabajo del taller, con vegetación y luz natural" width="1800" height="1200" /></figure><section class="studio-story page-pad"><h2 data-reveal>Un taller para<br />pensar distinto.</h2><div><p class="large-copy">Creemos en la precisión con la que una ventana enmarca un árbol. En el tacto fresco de la piedra. En la luz que cambia una habitación.</p><p>Fundado en {site.brand.founded}, Estrato reúne arquitectura, interiorismo y dirección constructiva. Trabajamos como un taller de artesanos y técnicos: exploramos, discutimos y resolvemos cada proyecto desde su contexto.</p><p>No partimos de una forma predeterminada. Partimos de las personas, del territorio y de una pregunta: ¿cómo queremos habitar?</p></div></section><section class="principles page-pad"><h2>Nuestra manera<br />de mirar.</h2><div>{principles.map(([title,desc]) => <article><h3>{title}</h3><p>{desc}</p></article>)}</div></section><StudioProcess /></BaseLayout>
