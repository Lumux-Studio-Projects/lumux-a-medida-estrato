---
import ArrowIcon from '../../components/ArrowIcon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const all = await getCollection('services');
const services = ['arquitectura-residencial','interiorismo-y-materia','consultoria-patrimonial'].map(id => all.find(s => s.id===id)!);
const names = ['Arquitectura','Interiorismo','Patrimonio'];
---
<BaseLayout title="Servicios"><header class="page-opening page-pad"><h1 data-reveal>De la idea<br />a la materia.</h1><div class="opening-bottom"><p>Una mirada completa al espacio.<br />Tres disciplinas que trabajan juntas.</p><a class="text-link" href="/contacto">Hablemos de tu proyecto <ArrowIcon /></a></div></header><section class="service-index page-pad">{services.map((s,i) => <a class="service-feature" href={`/servicios/${s.id}`}><div class="service-image"><img src={s.data.coverImage} alt={s.data.title} width="1400" height="1000" loading="lazy" /></div><div class="service-feature-text"><h2>{names[i]}<span aria-hidden="true"><ArrowIcon /></span></h2><p>{s.data.lead}</p><span class="text-link">Explorar servicio <ArrowIcon /></span></div></a>)}</section></BaseLayout>
