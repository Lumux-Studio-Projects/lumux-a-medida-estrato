---
interface Props {
  title: string;
  shortDescription: string;
  category: string;
  coverImage: string;
  deliverables: string[];
  slug: string;
  ctaLabel: string;
}

const {
  title,
  shortDescription,
  category,
  coverImage,
  deliverables,
  slug,
  ctaLabel
} = Astro.props;
---

<article class="service-card">
  <div class="service-image-col">
    <a href={`/servicios/${slug}`} class="service-image-link" aria-label={`Ver detalles del servicio ${title}`}>
      <img src={coverImage} alt={title} loading="lazy" class="service-img" />
    </a>
  </div>

  <div class="service-content-col">
    <div class="service-header">
      <span class="tag-meta">{category}</span>
      <h3 class="service-title">
        <a href={`/servicios/${slug}`}>{title}</a>
      </h3>
      <p class="service-desc">{shortDescription}</p>
    </div>

    <div class="service-deliverables">
      <h4 class="deliverables-heading">Alcance y entregables clave:</h4>
      <ul class="deliverables-list">
        {deliverables.slice(0, 3).map((item) => (
          <li>
            <span class="check-bullet" aria-hidden="true">—</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="service-actions">
      <a href={`/servicios/${slug}`} class="btn btn-secondary">
        Ver Detalle de Servicio
      </a>
      <a href={`/contacto?servicio=${slug}`} class="link-editorial">
        {ctaLabel} →
      </a>
    </div>
  </div>
</article>

<style>
  .service-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding: 2.5rem;
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    align-items: center;
    transition: border-color var(--transition-fast);
  }

  .service-card:hover {
    border-color: var(--color-accent);
  }

  @media (min-width: 840px) {
    .service-card {
      grid-template-columns: 1.1fr 1.3fr;
      gap: 3.5rem;
    }
  }

  .service-image-col {
    overflow: hidden;
    border-radius: var(--radius-xs);
  }

  .service-image-link {
    display: block;
    aspect-ratio: 16 / 11;
    overflow: hidden;
  }

  .service-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .service-image-link:hover .service-img {
    transform: scale(1.03);
  }

  .service-content-col {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .service-title {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    color: var(--color-text-primary);
    margin: 0.5rem 0 0.75rem;
  }

  .service-title a:hover {
    color: var(--color-accent);
  }

  .service-desc {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .deliverables-heading {
    font-size: 0.8125rem;
    font-family: var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-primary);
    margin-bottom: 0.75rem;
    font-weight: 600;
  }

  .deliverables-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .deliverables-list li {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    display: flex;
    gap: 0.625rem;
    line-height: 1.45;
  }

  .check-bullet {
    color: var(--color-accent);
    font-weight: bold;
  }

  .service-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding-top: 0.5rem;
  }
</style>
