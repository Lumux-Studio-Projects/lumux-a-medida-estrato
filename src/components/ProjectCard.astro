---
interface Props {
  title: string;
  subtitle: string;
  category: string;
  year: number;
  location: string;
  heroImage: string;
  slug: string;
  aspect?: 'wide' | 'tall';
}

const { 
  title, 
  subtitle, 
  category, 
  year, 
  location, 
  heroImage, 
  slug,
  aspect = 'wide'
} = Astro.props;
---

<article class:list={['project-card', `aspect-${aspect}`]}>
  <a href={`/proyectos/${slug}`} class="project-media-link" aria-label={`Ver proyecto ${title}`}>
    <div class="project-image-wrap">
      <img 
        src={heroImage} 
        alt={`Fotografía del proyecto ${title}`} 
        loading="lazy" 
        class="project-img"
      />
      <div class="project-overlay">
        <span class="overlay-badge">Explorar Obra →</span>
      </div>
    </div>
  </a>

  <div class="project-meta-bar">
    <div class="meta-left">
      <span class="tag-meta">{category}</span>
      <span class="tag-dot">·</span>
      <span class="tag-meta">{year}</span>
    </div>
    <span class="tag-meta meta-location">{location}</span>
  </div>

  <h3 class="project-title">
    <a href={`/proyectos/${slug}`}>{title}</a>
  </h3>
  <p class="project-subtitle">{subtitle}</p>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .project-media-link {
    display: block;
    overflow: hidden;
    border-radius: var(--radius-xs);
    background-color: var(--color-bg-secondary);
  }

  .project-image-wrap {
    position: relative;
    overflow: hidden;
    width: 100%;
    aspect-ratio: 16 / 10;
  }

  .aspect-tall .project-image-wrap {
    aspect-ratio: 4 / 5;
  }

  .project-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-media-link:hover .project-img {
    transform: scale(1.04);
  }

  .project-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.45) 0%, transparent 50%);
    display: flex;
    align-items: flex-end;
    padding: 1.5rem;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .project-media-link:hover .project-overlay {
    opacity: 1;
  }

  .overlay-badge {
    background-color: #FFFFFF;
    color: #1C1B19;
    padding: 0.4rem 0.875rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: var(--radius-xs);
  }

  .project-meta-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--color-border-light);
    padding-bottom: 0.5rem;
  }

  .meta-left {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  .tag-dot {
    color: var(--color-text-muted);
  }

  .project-title {
    font-size: 1.625rem;
    color: var(--color-text-primary);
    margin-top: 0.25rem;
  }

  .project-title a {
    transition: color 0.2s ease;
  }

  .project-title a:hover {
    color: var(--color-accent);
  }

  .project-subtitle {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }
</style>
